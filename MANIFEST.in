include ACKNOWLEDGEMENTS.md
include README.md
include CITATION.cff
include CONTRIBUTING.md
include LICENSE
include SECURITY.md
include requirements.txt
include run_suite2p_in_depth.py
recursive-include paper *.py
recursive-include docs *.md
recursive-include tests *.py
prune scratch_files
prune Data
prune .idea
prune paper/data
exclude paper/*.csv
exclude plain_suite2p.yaml
exclude zregistration.yaml
exclude zstack.yaml
exclude trace_correction.yaml
exclude preprocess_boutons.csv
exclude preprocess_neurons.csv
exclude planes_to_flyback.csv
exclude zoom_to_microns.csv
global-exclude .DS_Store
global-exclude *.py[cod]
